        :root {
            --color-primary: #0C2136;   /* Azul Marino Serranoble */
            --color-secondary: #E6AA38; /* Dorado / Amarillo Trigo */
            --color-bg: #f4f6f9;
        }

        body {
            background-color: var(--color-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Encabezado */
        .header-brand {
            background-color: var(--color-primary);
            border-bottom: 4px solid var(--color-secondary);
            padding: 20px 0;
            text-align: center;
        }

        .logo-img {
            max-width: 180px;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        /* Tarjeta del Formulario */
        .card-custom {
            border: none;
            border-top: 5px solid var(--color-secondary);
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        }

        .btn-serranoble {
            background-color: var(--color-primary);
            color: #ffffff;
            border: 2px solid var(--color-secondary);
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-serranoble:hover {
            background-color: var(--color-secondary);
            color: var(--color-primary);
            border-color: var(--color-primary);
        }

        /* Botón Directo de WhatsApp */
        .btn-whatsapp {
            background-color: #25D366;
            color: white;
            font-weight: bold;
            border-radius: 50px;
            padding: 10px 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .btn-whatsapp:hover {
            background-color: #1ebd56;
            color: white;
            transform: translateY(-2px);
        }

        /* Personalización SweetAlert2 */
        .swal2-popup-serranoble {
            border-top: 5px solid var(--color-secondary) !important;
        }